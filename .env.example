# Copy this file to .env and fill in real values. .env is gitignored.

# Required for backend/llm/client.py's GeminiProvider (used by state
# extraction and the Investigation Agent). google.genai.Client() reads
# either of these automatically.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Required for backend/llm/vertexai.py's VertexAIProvider (MODEL_PROVIDER=vertexai).
# Auth is via Application Default Credentials, not an API key -- either
# `gcloud auth application-default login` locally, or point
# GOOGLE_APPLICATION_CREDENTIALS at a service account JSON key with the
# "Vertex AI User" (roles/aiplatform.user) role for deployment.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
GOOGLE_APPLICATION_CREDENTIALS=

# ClickHouse connection (backend/clickhouse/client.py). Defaults shown match
# docker-compose.yml (local, no TLS).
#
# For ClickHouse Cloud instead: set CLICKHOUSE_HOST to your instance's
# hostname (e.g. abc-123.us-east-2.aws.clickhouse.cloud, no https:// prefix),
# CLICKHOUSE_PORT=8443, CLICKHOUSE_PASSWORD to the Cloud password, and
# CLICKHOUSE_SECURE=true (Cloud terminates HTTPS only and rejects a plaintext
# connection on 8123). CLICKHOUSE_USER/CLICKHOUSE_DB stay the same shape
# (default / storytrace) unless you created a different user or database
# in the Cloud console.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=admin
CLICKHOUSE_DB=storytrace
CLICKHOUSE_SECURE=false

# Required for backend/auth.py's JWT signing. Generate a real value with
# `openssl rand -hex 32` -- never commit an actual secret here.
JWT_SECRET=

# Comma-separated list of allowed frontend origins for CORS (backend/api/main.py).
FRONTEND_ORIGIN=http://localhost:3000

# "ollama" (default, local/free), "gemini" (API key), or "vertexai" (GCP project + ADC).
MODEL_PROVIDER=ollama
